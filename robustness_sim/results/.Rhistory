M <- 1500
avg_pmf <- function(l_vals, psi_i, FUN, ...) {
vapply(l_vals, function(ell) mean(FUN(ell, psi_i, ...)), numeric(1))
}
l_vals <- 2:M
# Geometric model
pmf_geom_7   <- avg_pmf(l_vals, psi_seed7, pL_geom_2M, phi = res_df7 %>% filter(model == "null") %>% pull(phi1), M = M)
pmf_geom_19   <- avg_pmf(l_vals, psi_seed19, pL_geom_2M, phi = res_df19 %>% filter(model == "null") %>% pull(phi1), M = M)
sum(pmf_geom_7*2:1500)
sum(pmf_geom_19*2:1500)
# Sum-of-two-geoms model
pmf_2geom_7  <- avg_pmf(l_vals, psi_seed7, pL_geom2_2M, phi = res_df7 %>% filter(model == "sum") %>% pull(phi1), M = M)
pmf_2geom_19  <- avg_pmf(l_vals, psi_seed19, pL_geom2_2M, phi = res_df19 %>% filter(model == "sum") %>% pull(phi1), M = M)
sum(pmf_2geom_7*2:1500)
sum(pmf_2geom_19*2:1500)
# Mixture model
pmf_mix_7    <- avg_pmf(l_vals, psi_seed7, pL_geom_2M_mixture,
w1 = res_df7 %>% filter(model == "mixture") %>% pull(w1), phi1 = res_df7 %>% filter(model == "mixture") %>% pull(phi1), phi2 = res_df7 %>% filter(model == "mixture") %>% pull(phi2), M = M)
pmf_mix_19    <- avg_pmf(l_vals, psi_seed19, pL_geom_2M_mixture,
w1 = res_df19 %>% filter(model == "mixture") %>% pull(w1), phi1 = res_df19 %>% filter(model == "mixture") %>% pull(phi1), phi2 = res_df19 %>% filter(model == "mixture") %>% pull(phi2), M = M)
sum(pmf_mix_7*2:1500)
sum(pmf_mix_19*2:1500)
# Empirical PMF
emp_cnt_7 <- tabulate(factor(data_seed7, levels = l_vals), nbins = length(l_vals))
emp_p_7   <- emp_cnt_7 / sum(emp_cnt_7)
emp_cnt_19 <- tabulate(factor(data_seed19, levels = l_vals), nbins = length(l_vals))
emp_p_19   <- emp_cnt_19 / sum(emp_cnt_19)
