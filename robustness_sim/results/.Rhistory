geom_errorbar(aes(ymin = q2.5, ymax = q97.5), width = 0.2) +
facet_wrap(vars(variable), scales = "free_y") +
theme_bw() +
labs(y = "Estimate (with 95% CI)", x = "Model")
geom2_plot_df <- res_df %>% filter(model == "sum")
