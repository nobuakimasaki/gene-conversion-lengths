source("../../UK_biobank/results/fns_sim.R")
M <- 1500
avg_pmf <- function(l_vals, psi_i, FUN, ...) {
vapply(l_vals, function(ell) mean(FUN(ell, psi_i, ...)), numeric(1))
}
l_vals <- 2:M
# Geometric model
pmf_geom_7   <- avg_pmf(l_vals, psi_seed7, pL_geom_2M, phi = res_df_7 %>% filter(model == "null") %>% pull(phi1), M = M)
library(dplyr)
library(ggplot2)
library(tidyr)
library(purrr)
library(tibble)
library(patchwork)
library(data.table)
library(stringr)
# load in data first
# find files like: sim5_seedX_10Mb...inf_obs_tracts (optionally with trailing digits/ext)
tract_files <- list.files(
"../data",
pattern = "^sim5_seed\\d+_10Mb.*inf_obs_tracts\\d*",
full.names = TRUE
)
# read & stack; add `seed` column parsed from filename
all_tracts <- rbindlist(lapply(tract_files, function(f) {
dt <- fread(f, header = FALSE)           # set header=TRUE if your files have headers
seed_num <- as.integer(str_match(basename(f), "sim5_seed(\\d+)_10Mb")[, 2])
dt[, seed := seed_num]
}), use.names = FALSE, fill = TRUE)
all_tracts$l <- all_tracts$V2 - all_tracts$V1 + 1
all_tracts_2_1500 <- all_tracts %>% filter(l > 1 & l <= 1500)
all_tracts_2_1500_counts <- all_tracts_2_1500 %>% group_by(seed) %>% summarize(n = n())
# Load main results files
file_list <- list.files(pattern = "^res.*seed[0-9]+.*\\.csv$", full.names = TRUE)
res_df <- lapply(file_list, function(file) {
df <- read.csv(file)[, -1]  # Drop first column
seed <- as.integer(sub(".*seed([0-9]+).*\\.csv$", "\\1", basename(file)))
df$seed <- seed
df$mean1 <- 1 / df$phi1
df$mean2 <- 1 / df$phi2
df
}) %>%
bind_rows()
res_df <- res_df %>% inner_join(all_tracts_2_1500_counts)
# Split by model
# For mixture model results, for each seed, get the optimization with the smallest resulting NLL
res_mixture <- res_df %>%
filter(model == "mixture") %>%
group_by(seed) %>%
slice_min(NLL, n = 1, with_ties = FALSE) %>%
ungroup()
res_mixture$BIC <- res_mixture$AIC - 6 + 3*log(res_mixture$n)
res_null <- res_df %>% filter(model == "null") %>% arrange(seed)
res_null$BIC <- res_null$AIC - 2 + log(res_null$n)
res_sum <- res_df %>% filter(model == "sum") %>% arrange(seed)
res_sum$BIC <- res_sum$AIC - 2 + log(res_sum$n)
# Recombine
res_df <- bind_rows(res_mixture, res_null, res_sum)
# Load bootstrap files
file_list_bootstrap <- list.files(pattern = "^bootstrap.*seed[0-9]+.*\\.csv$", full.names = TRUE)
# In each bootstrap file, paste seed and additional information about the mean.
# Then, for each model, seed, bootstrap iter., get the optimization resulting in smallest NLL
res_boot <- lapply(file_list_bootstrap, function(file) {
df <- read.csv(file)
seed <- as.integer(sub(".*seed([0-9]+).*\\.csv$", "\\1", basename(file)))
df$seed <- seed
df$mean1 <- 1 / df$phi1
df$mean2 <- 1 / df$phi2
df
}) %>%
bind_rows() %>%
group_by(model, bootstrap, seed) %>%
slice_min(NLL, with_ties = FALSE) %>%
ungroup() %>%
arrange(model, seed, bootstrap)
res_boot <- inner_join(res_boot, all_tracts_2_1500_counts)
# 500*3*20 = 30000 (ok)
# Compute quantiles for bootstrap
q_probs <- c(0.025, 0.975)
vars <- c("NLL", "AIC", "BIC", "w1", "phi1", "phi2", "mean1", "mean2", "mean")
# For each seed and model, calculate quantile
quantiles_df <- res_boot %>%
group_by(seed, model) %>%
group_split() %>%
map_dfr(function(subdf) {
tibble(
seed = unique(subdf$seed),
model = unique(subdf$model),
!!!map(vars, ~ setNames(quantile(subdf[[.x]], probs = q_probs, na.rm = TRUE), paste0(.x, "_q", q_probs * 100))) %>%
flatten_dbl()
)
})
# Join quantiles onto res_df
res_df <- inner_join(res_df, quantiles_df)
# Find best overall model per seed
df_min_bic <- res_df %>%
group_by(seed) %>%
slice_min(BIC, with_ties = FALSE) %>%
ungroup()
res_null <- res_df %>% filter(model == "null")
# Plot for "null" model
ggplot(res_null, aes(x = seed, y = mean)) +
geom_point() +
geom_errorbar(aes(ymin = mean_q2.5, ymax = mean_q97.5), width = 0.2) +
scale_y_continuous(expand = c(0, 0), limits = c(0, 350)) +
geom_hline(yintercept = 300, linetype = "dotted") +
theme_bw() +
labs(x = "Replicate", y = "Estimate (bp)")
ggsave("sim.p1.png", height = 4, width = 7)
mean(res_null$mean)
# Long format for mixture model
df_min_bic_mixture <- df_min_bic %>% filter(model == "mixture")
# Main estimates
df_long <- df_min_bic_mixture %>%
pivot_longer(cols = c(w1, mean1, mean2, mean),
names_to = "parameter", values_to = "est") %>%
select(seed, parameter, est)
# 2.5% quantiles
df_long_2.5 <- df_min_bic_mixture %>%
pivot_longer(cols = c(w1_q2.5, mean1_q2.5, mean2_q2.5, mean_q2.5),
names_to = "parameter", values_to = "q2.5") %>%
mutate(parameter = gsub("_q2\\.5", "", parameter)) %>%
select(seed, parameter, q2.5)
# 97.5% quantiles
df_long_97.5 <- df_min_bic_mixture %>%
pivot_longer(cols = c(w1_q97.5, mean1_q97.5, mean2_q97.5, mean_q97.5),
names_to = "parameter", values_to = "q97.5") %>%
mutate(parameter = gsub("_q97\\.5", "", parameter)) %>%
select(seed, parameter, q97.5)
# Merge everything
mixture_long <- df_long %>%
left_join(df_long_2.5, by = c("seed", "parameter")) %>%
left_join(df_long_97.5, by = c("seed", "parameter"))
# Recode labels
mixture_long <- mixture_long %>%
mutate(parameter = recode(parameter,
mean = "Overall~Mean",
mean1 = "phi[1]",
mean2 = "phi[2]",
w1 = "w[1]"))
# Individual small plots
p_mean_phi <- ggplot(mixture_long %>% filter(parameter != "w[1]"),
aes(x = as.factor(seed), y = est)) +
geom_point() +
geom_errorbar(aes(ymin = q2.5, ymax = q97.5), width = 0.2) +
facet_wrap(~parameter, nrow = 1, labeller = label_parsed) +
scale_y_continuous(limits = c(0, 350), expand = c(0, 0)) +
geom_hline(data = mixture_long %>% filter(parameter == "Overall~Mean") %>% distinct(parameter),
aes(yintercept = 300),
linetype = "dotted") +
theme_bw() +
labs(x = "Replicate", y = "Estimate (bp)")
p_w1 <- ggplot(mixture_long %>% filter(parameter == "w[1]"),
aes(x = as.factor(seed), y = est)) +
geom_point() +
geom_errorbar(aes(ymin = q2.5, ymax = q97.5), width = 0.2) +
facet_wrap(~parameter, nrow = 1, labeller = label_parsed) +
scale_y_continuous(limits = c(0, 1), expand = c(0, 0)) +
theme_bw() +
labs(x = "Replicate", y = "Estimate")
# Combine into one row
combined_plot <- wrap_plots(p_mean_phi, p_w1, nrow = 1, widths = c(3, 1))
# Save the combined plot
ggsave("sim.p2.png", combined_plot, height = 4, width = 7)
res_df <- res_df %>% arrange(model, seed)
BIC_mixture <- res_df$BIC[1:20]
BIC_null <- res_df$BIC[21:40]
BIC_sum <- res_df$BIC[41:60]
min(BIC_mixture - BIC_null) # larger values prefer null
max(BIC_mixture - BIC_null)
min(BIC_sum - BIC_null) # larger values prefer null
max(BIC_sum - BIC_null)
BIC_null - BIC_mixture
res_df_filt <- res_df %>% filter(seed %in% c(7,19))
res_df_filt$BIC[1:2] - res_df_filt$BIC[3:4]
# List all files that start with 'l_psi' and end with '.csv'
files <- list.files(pattern = "^l_psi.*\\.csv$")
# Read, filter, and count rows with l between 2 and 1500 (inclusive)
counts <- files %>%
set_names() %>%
map_dfr(~ {
read.csv(.x) %>%
filter(l >= 2, l <= 1500) %>%
summarise(count = n(), .groups = "drop") %>%
mutate(source = .x)
})
# View result
min(counts$count)
max(counts$count)
# Read and annotate each file with the seed number
data <- files %>%
map_dfr(~ {
seed <- str_extract(.x, "(?<=l_psi_seed)\\d+")
read.csv(.x) %>%
filter(l >= 2, l <= 1500) %>%
mutate(seed = as.integer(seed))
})
psi_seed7 <- data %>% filter(seed == 7) %>% pull(psi)
psi_seed19 <- data %>% filter(seed == 19) %>% pull(psi)
data_seed7 <- data %>% filter(seed == 7) %>% pull(l)
data_seed19 <- data %>% filter(seed == 19) %>% pull(l)
res_df7 <- res_df_filt %>% filter(seed == 7)
res_df19 <- res_df_filt %>% filter(seed == 19)
# counts2 <- data %>% group_by(seed) %>% summarize(count = n())
#
# # View result
# min(counts2$count)
# max(counts2$count)
