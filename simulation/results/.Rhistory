source("../../UK_biobank/results/fns_sim.R")
M <- 1500
avg_pmf <- function(l_vals, psi_i, FUN, ...) {
vapply(l_vals, function(ell) mean(FUN(ell, psi_i, ...)), numeric(1))
}
l_vals <- 2:M
# Geometric model
pmf_geom_7   <- avg_pmf(l_vals, psi_seed7, pL_geom_2M, phi = res_df7 %>% filter(model == "null") %>% pull(phi1), M = M)
# Sum-of-two-geoms model
pmf_2geom_7  <- avg_pmf(l_vals, psi_seed7, pL_geom2_2M, phi = res_df7 %>% filter(model == "sum") %>% pull(phi1), M = M)
# Mixture model
pmf_mix_7    <- avg_pmf(l_vals, psi_seed7, pL_geom_2M_mixture,
w1 = res_df7 %>% filter(model == "mixture") %>% pull(w1), phi1 = res_df7 %>% filter(model == "mixture") %>% pull(phi1), phi2 = res_df7 %>% filter(model == "mixture") %>% pull(phi2), M = M)
# Empirical PMF
emp_cnt_7 <- tabulate(factor(data_seed7, levels = l_vals), nbins = length(l_vals))
emp_p_7   <- emp_cnt_7 / sum(emp_cnt_7)
### Model fit plot
# ---- Tidy + plot -----------------------------------------------------
df_7 <- tibble(l = l_vals,
Empirical = emp_p_7,
Geometric = pmf_geom_7,
Sum   = pmf_2geom_7,
Mixture   = pmf_mix_7) %>%
pivot_longer(-l, names_to = "series", values_to = "p")
BIN = 50
binned <- df_7 %>%
mutate(
bin_start = ((l - 1) %/% BIN) * BIN + 1,
bin_end   = bin_start + BIN - 1,
bin       = paste0(bin_start, "–", bin_end)
) %>%
group_by(series, bin_start, bin_end, bin) %>%
summarise(p = sum(p), n = dplyr::n(), .groups = "drop") %>%
arrange(series, bin_start)
ggplot(binned, aes(bin_start)) +
geom_col(data = dplyr::filter(binned, series == "Empirical"),
aes(y = p), fill = "grey80", width = 1, alpha = 0.8) +
geom_line(data = dplyr::filter(binned, series != "Empirical"),
aes(y = p, colour = series), linewidth = 0.8) +
labs(x = "Tract length", y = "Log 10 probability") +
scale_y_continuous(trans = "log10") +
scale_color_discrete(
name   = "Model",
breaks = c("Geometric", "Sum", "Mixture"),   # <- match your actual `series` values
labels = c("Geometric", "Sum", "Mixture")
) +
theme_bw() +
theme(legend.position = "bottom")
